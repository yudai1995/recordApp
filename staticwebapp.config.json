{
  "routes": [
    {
      "route": "/"
    },
    {
      "route": "/dashboard"
    },
    {
      "route": "/list"
    },
    {
      "route": "/detail/*"
    },
    {
      "route": "/history"
    },
    {
      "route": "/setting"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none'"
  }
}
