{
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/dashboard",
      "rewrite": "/index.html"
    },
    {
      "route": "/list",
      "rewrite": "/index.html"
    },
    {
      "route": "/detail/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/history",
      "rewrite": "/index.html"
    },
    {
      "route": "/setting",
      "rewrite": "/index.html"
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none'"
  }
}
